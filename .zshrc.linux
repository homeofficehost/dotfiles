# ~/.zshrc.linux — só Linux (sourced pelo ~/.zshrc)

# ─── oh-my-zsh ────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
COMPLETION_WAITING_DOTS="true"
DISABLE_UNTRACKED_FILES_DIRTY="true"
HIST_STAMPS="dd/mm/yyyy"
export CASE_SENSITIVE="false"
export DISABLE_UPDATE_PROMPT="true"
export DISABLE_AUTO_TITLE="true"
plugins=(
    git
    archlinux
    compleat
    dirpersist
    dircycle
    zsh-autosuggestions
    zsh-syntax-highlighting
)
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

bindkey -v

# ─── Aliases ──────────────────────────────────────────────────────────────────
# lsd no lugar de ls
alias ls='lsd'
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'
alias lt='ls --tree'

alias sf="spf"
alias k="spf"
alias ld="doko"
alias lddd="lazydocker"
alias dev="cd ~/dev/"
alias rm='gio trash'
alias emu="nvm use 16; firebase emulators:start --import=./firebase-data --export-on-exit"

# futurecommit "1h30m" "mensagem" (date do GNU)
alias futurecommit='export GIT_AUTHOR_DATE="$(date -d "1 day" --utc)" && export GIT_COMMITTER_DATE="$GIT_AUTHOR_DATE" && git commit -m'

# Rede
alias net-off='sudo ip link set enp8s0 down'
alias net-on='sudo ip link set enp8s0 up'

# Visualização do histórico git com gource
alias vizgit="
gource \
    -s .03 \
    -1920x1080 \
    --seconds-per-day 0.25 \
    --auto-skip-seconds .1 \
    --multi-sampling \
    --stop-at-end \
    --key \
    --highlight-users \
    --date-format "%d/%m/%y" \
    --hide mouse,filenames \
    --file-idle-time 0 \
    --max-files 0  \
    --background-colour 000000 \
    --font-size 25 \
    --output-ppm-stream - \
    --output-framerate 30 \
    --colour-images \
    --title 'Visualization' \
    | ffmpeg -y -r 30 -f image2pipe -vcodec ppm -i - -b 65536K movie.mp4"

# ─── GTK dark mode ────────────────────────────────────────────────────────────
export GTK_THEME=Flat-Remix-GTK-Blue-Dark
export GTK_ICON_THEME=Flat-Remix-Blue-Dark

# ─── uv/env local ─────────────────────────────────────────────────────────────
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# ─── Restaura último diretório entre sessões ──────────────────────────────────
chpwd_functions+=(save_current_dir)
save_current_dir() { export SHELL_SESSION_HISTORY_DIR="$PWD"; }
if [ -n "$SHELL_SESSION_HISTORY_DIR" ] && [ -d "$SHELL_SESSION_HISTORY_DIR" ]; then cd "$SHELL_SESSION_HISTORY_DIR"; fi
