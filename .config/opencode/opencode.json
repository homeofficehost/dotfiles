  "disabled_providers": [
    "anthropic",
    "cloudflare-ai-gateway",
    "fireworks-ai",
    "kimi-for-coding",
    "minimax",
    "minimax-cn",
    "minimax-cn-coding-plan",
    "minimax-coding-plan",
    "zai-coding-plan"
  ],
  "plugin": [
    "oh-my-openagent@latest",
    "opencode-background-agents@latest",
    "@cortexkit/opencode-magic-context@0.49.18",
    "@warp-dot-dev/opencode-warp"
  ],
  "experimental": {
    "disable_paste_summary": true
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol-fast"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol-fast"
    },
    "local": {
      "description": "Agente enxuto para modelos locais no devworkstation",
      "mode": "primary",
      "model": "ollama-devws/qwen38-9b-heretic-q5km-32k",
      "temperature": 0.2,
      "prompt": "/no_think\nVocê é um assistente de programação conciso. Responda curto, em português. Use as ferramentas só quando necessário.\nPara info atual: use web_search (curto) e depois web_read só na melhor url.",
      "tools": {
        "webfetch": false,
        "todowrite": false,
        "todoread": false,
        "task": false,
        "patch": false,
        "list": false,
        "dokploy*": false,
        "cloudflare*": false,
        "websearch": false,
        "codesearch": false,
        "lsp": false,
        "bitwarden*": false,
        "swarmui*": true,
        "web*": true
      },
      "permission": {
        "edit": "allow",
        "skill": {
          "*": "deny",
          "local-*": "allow"
        }
      }
    },
    "colibri": {
      "description": "Chat rápido no colibri (LFM3-VL 2B, ~170 tok/s), sem ferramentas",
      "mode": "primary",
      "model": "colibri/lfm3-vl-2b-colibri",
      "temperature": 0.3,
      "prompt": "Você é um assistente conciso. Responda curto, em português. Você não tem ferramentas: responda só com o que sabe.",
      "tools": {
        "*": false
      }
    },
    "title": {
      "model": "titulos/auto"
    }
  },
  "mcp": {
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "dokploy": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@ahdev/dokploy-mcp@latest"
      ],
      "environment": {
        "DOKPLOY_URL": "https://panel.buildaut.com.au/api",
        "DOKPLOY_API_KEY": "{env:DOKPLOY_API_KEY}"
      },
      "enabled": true
    },
    "bitwarden": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@bitwarden/mcp-server@2026.7.0"
      ],
      "environment": {
        "BW_SESSION": "{env:BW_SESSION}"
      },
      "enabled": true
    },
    "swarmui": {
      "type": "remote",
      "url": "https://swarm-mcp.home.arpa/mcp",
      "enabled": true
    },
    "web": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--quiet",
        "--script",
        "/Users/tg/.config/opencode/scripts/web_mcp.py"
      ],
      "enabled": true
    }
  },
  "model": "openai/gpt-5.6-sol-fast",
  "small_model": "titulos/auto"
}
