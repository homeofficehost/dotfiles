    },
    "mlx-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX Local (Qwen3.5-9B)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "mlx-local"
      },
      "models": {
        "mlx-community/Qwen3.5-9B-MLX-4bit": {
          "name": "Qwen3.5-9B MLX (local)",
          "limit": { "context": 32768, "output": 4096 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },
  "disabled_providers": [
    "anthropic",
    "cloudflare-ai-gateway",
    "fireworks-ai",
    "kimi-for-coding",
    "minimax",
    "minimax-cn",
    "minimax-cn-coding-plan",
    "minimax-coding-plan",
    "zai-coding-plan"
  ],
  "plugin": [
    "oh-my-openagent@latest",
    "opencode-agent-skills@latest",
    "opencode-background-agents@latest",
    "@cortexkit/opencode-magic-context@0.33.1",
    "@warp-dot-dev/opencode-warp",
    "@zhafron/opencode-kiro-auth"
  ],
  "experimental": {
    "disable_paste_summary": true
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "agent": {
    "build": { "model": "openai/gpt-5.6-sol-fast" },
    "plan": { "model": "openai/gpt-5.6-sol-fast" },
    "title": { "model": "kiro/claude-haiku-4-5" }
  },
  "mcp": {
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "dokploy": {
      "type": "local",
      "command": ["npx", "-y", "@ahdev/dokploy-mcp@latest"],
      "environment": {
        "DOKPLOY_URL": "https://panel.buildaut.com.au/api",
        "DOKPLOY_API_KEY": "{env:DOKPLOY_API_KEY}"
      },
      "enabled": true
    }
  },
  "model": "openai/gpt-5.6-sol-fast",
  "small_model": "kiro/claude-haiku-4-5"
}
